{
  "name": "Rico Blobby Volleyball",
  "short_name": "Rico Volley",
  "description": "Original beach blob volleyball arcade game",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "background_color": "#053d65",
  "theme_color": "#087ec0",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "orientation": "landscape",
  "display_override": [
    "fullscreen",
    "standalone"
  ]
}
